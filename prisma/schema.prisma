  acknowledgedAt     DateTime?
  returnedAt         DateTime?
  returnCondition    HrAssetCondition?
  returnNotes        String?
  status             HrAssetAssignmentStatus @default(ACTIVE)
  assignedById       String
  returnRecordedById String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  organization       HrOrganization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  asset              HrAsset                 @relation(fields: [assetId], references: [id], onDelete: Restrict)
  employee           HrEmployee              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  assignedBy         HrUser                  @relation("AssetAssignmentCreator", fields: [assignedById], references: [id], onDelete: Restrict)
  returnRecordedBy   HrUser?                 @relation("AssetReturnRecorder", fields: [returnRecordedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status, expectedReturnAt])
  @@index([employeeId, status, assignedAt])
  @@index([assetId, status, assignedAt])
}

model HrLifecycleTemplate {
  id             String                    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  type           HrLifecycleType
  version        Int
  active         Boolean                   @default(true)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  organization   HrOrganization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tasks          HrLifecycleTemplateTask[]
  instances      HrLifecycleInstance[]

  @@unique([organizationId, name, type, version])
  @@index([organizationId, type, active])
}

model HrLifecycleTemplateTask {
  id              String                   @id @default(cuid())
  templateId      String
  key             String
  title           String
  description     String?
  ownerType       HrLifecycleTaskOwnerType
  dueOffsetDays   Int                      @default(0)
  required        Boolean                  @default(true)
  instructions    String?
  sortOrder       Int                      @default(0)
  predecessorKeys String[]                 @default([])
  createdAt       DateTime                 @default(now())
  template        HrLifecycleTemplate      @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@unique([templateId, key])
  @@index([templateId, sortOrder])
}

model HrLifecycleInstance {
  id                    String              @id @default(cuid())
  organizationId        String
  templateId            String
  employeeId            String
  type                  HrLifecycleType
  status                HrLifecycleStatus   @default(DRAFT)
  effectiveDate         DateTime
  startedAt             DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?
  knowledgeTransferToId String?
  exitInterviewNotes    String?
  createdById           String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  organization          HrOrganization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  template              HrLifecycleTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  employee              HrEmployee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  knowledgeTransferTo   HrEmployee?         @relation("LifecycleKnowledgeTransfer", fields: [knowledgeTransferToId], references: [id], onDelete: Restrict)
  createdBy             HrUser              @relation("LifecycleInstanceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tasks                 HrLifecycleTask[]

  @@index([organizationId, type, status, effectiveDate])
  @@index([employeeId, type, status])
}

model HrLifecycleTask {
  id                String                   @id @default(cuid())
  organizationId    String
  instanceId        String
  templateTaskKey   String
  title             String
  description       String?
  ownerType         HrLifecycleTaskOwnerType
  assignedUserId    String?
  dueAt             DateTime
  required          Boolean                  @default(true)
  status            HrLifecycleTaskStatus    @default(PENDING)
  instructions      String?
  predecessorKeys   String[]                 @default([])
  completionNotes   String?
  evidenceReference String?
  completedAt       DateTime?
  completedById     String?
  skippedAt         DateTime?
  skipReason        String?
  reminderSentAt    DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  organization      HrOrganization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  instance          HrLifecycleInstance      @relation(fields: [instanceId], references: [id], onDelete: Restrict)
  assignedUser      HrUser?                  @relation("LifecycleTaskAssignee", fields: [assignedUserId], references: [id], onDelete: Restrict)
  completedBy       HrUser?                  @relation("LifecycleTaskCompleter", fields: [completedById], references: [id], onDelete: Restrict)

  @@unique([instanceId, templateTaskKey])
  @@index([organizationId, status, dueAt])
  @@index([assignedUserId, status, dueAt])
}

model HrWorkflowDefinition {
  id             String                      @id @default(cuid())
  organizationId String
  key            String
  name           String
  description    String?
  module         String
  subjectType    String
  version        Int
  active         Boolean                     @default(true)
  createdById    String
  createdAt      DateTime                    @default(now())
  organization   HrOrganization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy      HrUser                      @relation("WorkflowDefinitionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  stages         HrWorkflowDefinitionStage[]
  instances      HrWorkflowInstance[]

  @@unique([organizationId, key, version])
  @@index([organizationId, module, subjectType, active])
}

model HrWorkflowDefinitionStage {
  id                    String                 @id @default(cuid())
  definitionId          String
  key                   String
  name                  String
  sortOrder             Int
  assigneeType          HrWorkflowAssigneeType
  assigneeUserIds       String[]               @default([])
  assigneePermissionKey String?
  approvalMode          HrWorkflowApprovalMode @default(ANY)
  quorum                Int?
  routingCondition      Json?
  dueOffsetHours        Int?
  createdAt             DateTime               @default(now())
  definition            HrWorkflowDefinition   @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  runs                  HrWorkflowStageRun[]

  @@unique([definitionId, key])
  @@unique([definitionId, sortOrder])
}

model HrWorkflowInstance {
  id                 String                   @id @default(cuid())
  organizationId     String
  definitionId       String
  subjectType        String
  subjectId          String
  subjectEmployeeId  String?
  context            Json
  status             HrWorkflowInstanceStatus @default(ACTIVE)
  currentStageOrder  Int?
  startedById        String
  startedAt          DateTime                 @default(now())
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  organization       HrOrganization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  definition         HrWorkflowDefinition     @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  startedBy          HrUser                   @relation("WorkflowInstanceStarter", fields: [startedById], references: [id], onDelete: Restrict)
  subjectEmployee    HrEmployee?              @relation(fields: [subjectEmployeeId], references: [id], onDelete: Restrict)
  stageRuns          HrWorkflowStageRun[]

  @@index([organizationId, status, startedAt])
  @@index([organizationId, subjectType, subjectId])
  @@index([subjectEmployeeId, status])
}

model HrWorkflowStageRun {
  id                String                    @id @default(cuid())
  organizationId    String
  instanceId        String
  definitionStageId String
  stageKey          String
  stageName         String
  sortOrder         Int
  approvalMode      HrWorkflowApprovalMode
  requiredApprovals Int
  approverUserIds   String[]                  @default([])
  status            HrWorkflowStageRunStatus  @default(PENDING)
  activatedAt       DateTime?
  dueAt             DateTime?
  completedAt       DateTime?
  createdAt         DateTime                  @default(now())
  organization      HrOrganization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  instance          HrWorkflowInstance        @relation(fields: [instanceId], references: [id], onDelete: Restrict)
  definitionStage   HrWorkflowDefinitionStage @relation(fields: [definitionStageId], references: [id], onDelete: Restrict)
  approvals         HrWorkflowApproval[]

  @@unique([instanceId, sortOrder])
  @@index([organizationId, status, dueAt])
}

model HrWorkflowApproval {
  id         String             @id @default(cuid())
  stageRunId String
  approverId String
  decision   HrWorkflowDecision
  reason     String
  createdAt  DateTime           @default(now())
  stageRun   HrWorkflowStageRun @relation(fields: [stageRunId], references: [id], onDelete: Restrict)
  approver   HrUser             @relation(fields: [approverId], references: [id], onDelete: Restrict)

  @@unique([stageRunId, approverId])
  @@index([approverId, createdAt])
}

model HrOrganizationSetting {
  id             String         @id @default(cuid())
  organizationId String
  key            String
  value          Json
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   HrOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}
