# Placeholders only. Configure real values in the hosting secret manager.
APP_ENV=staging
HR_BOOTSTRAP_CONFIRM_ENV=staging
HR_BOOTSTRAP_ENABLED=false
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
APPLICATION_BASE_URL=https://staging.zentricanalytics.com
NEXT_PUBLIC_SITE_URL=https://staging.zentricanalytics.com
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_SESSION_TTL=28800

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD_HASH=replace-with-bcrypt-12-or-higher-hash

EMAIL_PROVIDER=console
EMAIL_FROM=hr@zentricanalytics.com
RESEND_API_KEY=replace-in-secret-manager-when-enabled
EMAIL_WORKER_SECRET=replace-with-at-least-32-random-characters
ORGANIZATION_WORKER_SECRET=replace-with-at-least-64-random-characters
DOCUMENT_SCANNER_SECRET=replace-with-at-least-32-random-characters
MONITORING_SECRET=replace-with-at-least-32-random-characters

OBJECT_STORAGE_PROVIDER=s3-compatible
OBJECT_STORAGE_ENDPOINT=https://s3-compatible-endpoint.example
OBJECT_STORAGE_BUCKET=zentric-hr-staging-private
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=replace-in-secret-manager
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-in-secret-manager
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_SERVER_SIDE_ENCRYPTION=AES256
UPLOAD_MAX_BYTES=20971520

# Existing recruitment private storage uses a persistent private volume (the Render private disk).
PRIVATE_OBJECT_STORAGE_PROVIDER=local-private
PRIVATE_UPLOAD_ROOT=/var/data/zentric-private-uploads

ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace-with-existing-legacy-hash
ACCESS_CODE_REQUEST_LIMIT=5
ACCESS_CODE_VERIFY_LIMIT=5
RATE_LIMIT_WINDOW_MS=900000
