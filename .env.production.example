# Placeholders only. Never commit real secrets or copy staging credentials.
APP_ENV=production
HR_BOOTSTRAP_CONFIRM_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@PRIVATE-HOST:PORT/DATABASE?sslmode=require
APPLICATION_BASE_URL=https://zentricanalytics.com
NEXT_PUBLIC_SITE_URL=https://zentricanalytics.com
AUTH_SECRET=replace-with-production-random-secret
AUTH_SESSION_TTL=28800
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD_HASH=replace-with-production-bcrypt-hash

EMAIL_PROVIDER=resend
EMAIL_FROM_CAREERS=careers@zentricanalytics.com
EMAIL_FROM_OFFERS=offers@zentricanalytics.com
EMAIL_FROM_HR=hr@zentricanalytics.com
EMAIL_FROM_ACCOUNTS=accounts@zentricanalytics.com
EMAIL_REPLY_TO_CAREERS=careers@zentricanalytics.com
EMAIL_REPLY_TO_OFFERS=offers@zentricanalytics.com
EMAIL_REPLY_TO_HR=hr@zentricanalytics.com
EMAIL_REPLY_TO_ACCOUNTS=support@zentricanalytics.com
RESEND_API_KEY=replace-in-secret-manager
EMAIL_WORKER_SECRET=replace-with-production-random-secret
ORGANIZATION_WORKER_SECRET=replace-with-production-64-character-random-secret
DOCUMENT_SCANNER_SECRET=replace-with-production-random-secret
MONITORING_SECRET=replace-with-production-random-secret

OBJECT_STORAGE_PROVIDER=aws-s3
OBJECT_STORAGE_BUCKET=zentric-hr-production-private
OBJECT_STORAGE_REGION=replace-with-approved-aws-region
AWS_ACCOUNT_ID=replace-with-aws-account-id
# Prefer a narrowly scoped IAM role; use static credentials only when role assumption is unavailable.
OBJECT_STORAGE_ACCESS_KEY_ID=replace-in-secret-manager
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-in-secret-manager
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_SERVER_SIDE_ENCRYPTION=AES256
MALWARE_SCANNER_PROVIDER=aws-guardduty-s3

DATABASE_BACKUP_PROVIDER=render-postgresql-plus-protected-logical-archives
# Render-managed PITR is seven days. Long-term logical archives are separate schedules.
DATABASE_PITR_RETENTION_DAYS=7
DATABASE_DAILY_BACKUP_RETENTION_DAYS=90
DATABASE_WEEKLY_BACKUP_RETENTION_DAYS=365
DATABASE_MONTHLY_ARCHIVE_RETENTION_YEARS=15
DATABASE_PITR_ENABLED=true
BACKUP_LAST_RESTORE_TEST_AT=replace-with-ISO-timestamp-from-a-successful-restore-drill
BACKUP_LAST_DR_EXERCISE_AT=replace-with-ISO-timestamp-from-a-successful-annual-exercise
BACKUP_EXECUTION_CONFIRM=render-scheduled-backup
BACKUP_ARCHIVE_ROOT=/var/backups/hrms-postgresql
BACKUP_ENCRYPTION_KEY_B64=replace-with-base64-encoded-32-byte-key
BACKUP_OBJECT_STORAGE_PROVIDER=aws-s3
BACKUP_OBJECT_STORAGE_BUCKET=zentric-production-database-archives
BACKUP_OBJECT_STORAGE_REGION=replace-with-approved-aws-region
BACKUP_OBJECT_STORAGE_ACCESS_KEY_ID=replace-in-secret-manager
BACKUP_OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-in-secret-manager
BACKUP_OBJECT_STORAGE_FORCE_PATH_STYLE=false
BACKUP_OBJECT_STORAGE_BUCKET_LOCK_ENABLED=true
