generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Applicant {
  id                  String           @id @default(cuid())
  organizationId      String?
  applicantNumber     String?          @unique
  normalizedEmail     String?
  normalizedPhone     String?
  version             Int              @default(1)
  fullName            String
  firstName           String?
  middleInitial       String?
  lastName            String?
  email               String
  phone               String?
  phoneCountryIso     String?
  phoneCountryName    String?
  phoneDialCode       String?
  phoneNationalNumber String?
  phoneE164           String?
  location            String?
  createdAt           DateTime         @default(now())
  applications        JobApplication[]

  @@index([organizationId, normalizedEmail])
  @@index([organizationId, normalizedPhone])
}

model JobApplication {
  id                   String                  @id @default(cuid())
  organizationId       String?
  vacancyId            String?
  applicationReference String?                 @unique
  submissionKey        String?                 @unique
  recruitmentStatus    String?
  assignedHiringTeamId String?
  applicationOwnerId   String?
  version              Int                     @default(1)
  applicationId        String                  @unique
  applicantId          String
  applicant            Applicant               @relation(fields: [applicantId], references: [id])
  roleAppliedFor       String
  workModePreference   String?
  experienceLevel      String?
  skills               String?
  portfolioUrl         String?
  message              String?
  privacyConsent       Boolean                 @default(false)
  status               String
  currentStageOrder    Int                     @default(1)
  stages               HiringStage[]
  documents            UploadedDocument[]
  emails               EmailNotification[]
  notes                AdminNote[]
  auditLogs            AuditLog[]
  accessCodes          ApplicationAccessCode[]
  offer                Offer?
  employmentAgreement  EmploymentAgreement?
  deletedAt            DateTime?
  deletedByAdminEmail  String?
  deleteReason         String?
  restoredAt           DateTime?
  restoredByAdminEmail String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  hrEmployee           HrEmployee?
  hrOrganization       HrOrganization?         @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, createdAt])
  @@index([organizationId, recruitmentStatus, createdAt])
  @@index([vacancyId, recruitmentStatus])
  @@index([assignedHiringTeamId, recruitmentStatus])
}

model HiringStage {
  id            String            @id @default(cuid())
  applicationId String
  application   JobApplication    @relation(fields: [applicationId], references: [id])
  stageKey      String
  stageOrder    Int
  title         String
  status        String            @default("Locked")
  unlockedAt    DateTime?
  submittedAt   DateTime?
  approvedAt    DateTime?
  metadata      Json?
  submissions   StageSubmission[]
  approvals     StageApproval[]
}

model StageSubmission {
  id          String               @id @default(cuid())
  stageId     String
  stage       HiringStage          @relation(fields: [stageId], references: [id])
  version     Int
  payload     Json
  status      String
  submittedAt DateTime?
  signature   ElectronicSignature?
  documents   ApplicantDocument[]
  createdAt   DateTime             @default(now())
}

model StageApproval {
  id         String      @id @default(cuid())
  stageId    String
  stage      HiringStage @relation(fields: [stageId], references: [id])
  action     String
  adminEmail String
  notes      String?
  createdAt  DateTime    @default(now())
}

model UploadedDocument {
  id                 String              @id @default(cuid())
  applicationId      String
  application        JobApplication      @relation(fields: [applicationId], references: [id])
  kind               String
  fileName           String
  mimeType           String
  sizeBytes          Int
  provider           String              @default("local-private")
  storageKey         String
  restricted         Boolean             @default(true)
  createdAt          DateTime            @default(now())
  applicantDocuments ApplicantDocument[]
}

model ApplicantDocument {
  id                 String           @id @default(cuid())
  submissionId       String
  submission         StageSubmission  @relation(fields: [submissionId], references: [id])
  uploadedDocumentId String
  uploadedDocument   UploadedDocument @relation(fields: [uploadedDocumentId], references: [id])
  status             String           @default("Submitted")
}

model ElectronicSignature {
  id           String          @id @default(cuid())
  submissionId String          @unique
  submission   StageSubmission @relation(fields: [submissionId], references: [id])
  typedName    String
  confirmed    Boolean
  signedAt     DateTime        @default(now())
  ipHash       String?
  userAgent    String?
}

model AdminNote {
  id            String         @id @default(cuid())
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id])
  adminEmail    String
  note          String
  createdAt     DateTime       @default(now())
}

model EmailNotification {
  id                String         @id @default(cuid())
  applicationId     String
  application       JobApplication @relation(fields: [applicationId], references: [id])
  toEmail           String
  template          String
  subject           String
  status            String
  providerMessageId String?
  failureReason     String?
  createdAt         DateTime       @default(now())
}

model Offer {
  id                    String         @id @default(cuid())
  applicationId         String         @unique
  application           JobApplication @relation(fields: [applicationId], references: [id])
  roleOffered           String
  salary                String
  startDate             DateTime
  workMode              String
  reportingManager      String?
  probationPeriod       String?
  offerExpiryDate       DateTime?
  specialConditions     String?
  status                String         @default("Draft")
  candidateDecisionAt   DateTime?
  candidateDecisionNote String?
  releasedAt            DateTime?
  releasedByAdminEmail  String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model EmploymentAgreement {
  id                   String         @id @default(cuid())
  applicationId        String         @unique
  application          JobApplication @relation(fields: [applicationId], references: [id])
  version              Int            @default(1)
  title                String         @default("Employment Agreement + Role Schedule")
  agreementText        String
  roleSchedule         Json
  status               String         @default("Draft")
  releasedAt           DateTime?
  releasedByAdminEmail String?
  candidateSubmittedAt DateTime?
  approvedAt           DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model AuditLog {
  id            String          @id @default(cuid())
  applicationId String?
  application   JobApplication? @relation(fields: [applicationId], references: [id])
  actorType     String
  actorRef      String?
  action        String
  metadata      Json?
  createdAt     DateTime        @default(now())
}

model ApplicationAccessCode {
  id                       String         @id @default(cuid())
  applicationId            String
  application              JobApplication @relation(fields: [applicationId], references: [id])
  codeHash                 String
  expiresAt                DateTime
  usedAt                   DateTime?
  verifiedSessionTokenHash String?
  sessionExpiresAt         DateTime?
  createdAt                DateTime       @default(now())
}

model ApplicationSequence {
  year      Int      @id
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}

model RateLimitEvent {
  id        String   @id @default(cuid())
  scope     String
  keyHash   String
  createdAt DateTime @default(now())

  @@index([scope, keyHash, createdAt])
}

