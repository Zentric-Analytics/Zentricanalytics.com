generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Applicant {
  id                  String           @id @default(cuid())
  fullName            String
  firstName           String?
  middleInitial       String?
  lastName            String?
  email               String
  phone               String?
  phoneCountryIso     String?
  phoneCountryName    String?
  phoneDialCode       String?
  phoneNationalNumber String?
  phoneE164           String?
  location            String?
  createdAt           DateTime         @default(now())
  applications        JobApplication[]
}

model JobApplication {
  id                   String                  @id @default(cuid())
  applicationId        String                  @unique
  applicantId          String
  applicant            Applicant               @relation(fields: [applicantId], references: [id])
  roleAppliedFor       String
  workModePreference   String?
  experienceLevel      String?
  skills               String?
  portfolioUrl         String?
  message              String?
  privacyConsent       Boolean                 @default(false)
  status               String
  currentStageOrder    Int                     @default(1)
  stages               HiringStage[]
  documents            UploadedDocument[]
  emails               EmailNotification[]
  notes                AdminNote[]
  auditLogs            AuditLog[]
  accessCodes          ApplicationAccessCode[]
  offer                Offer?
  employmentAgreement  EmploymentAgreement?
  deletedAt            DateTime?
  deletedByAdminEmail  String?
  deleteReason         String?
  restoredAt           DateTime?
  restoredByAdminEmail String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  hrEmployee           HrEmployee?
}

model HiringStage {
  id            String            @id @default(cuid())
  applicationId String
  application   JobApplication    @relation(fields: [applicationId], references: [id])
  stageKey      String
  stageOrder    Int
  title         String
  status        String            @default("Locked")
  unlockedAt    DateTime?
  submittedAt   DateTime?
  approvedAt    DateTime?
  metadata      Json?
  submissions   StageSubmission[]
  approvals     StageApproval[]
}

model StageSubmission {
  id          String               @id @default(cuid())
  stageId     String
  stage       HiringStage          @relation(fields: [stageId], references: [id])
  version     Int
  payload     Json
  status      String
  submittedAt DateTime?
  signature   ElectronicSignature?
  documents   ApplicantDocument[]
  createdAt   DateTime             @default(now())
}

model StageApproval {
  id         String      @id @default(cuid())
  stageId    String
  stage      HiringStage @relation(fields: [stageId], references: [id])
  action     String
  adminEmail String
  notes      String?
  createdAt  DateTime    @default(now())
}

model UploadedDocument {
  id                 String              @id @default(cuid())
  applicationId      String
  application        JobApplication      @relation(fields: [applicationId], references: [id])
  kind               String
  fileName           String
  mimeType           String
  sizeBytes          Int
  provider           String              @default("local-private")
  storageKey         String
  restricted         Boolean             @default(true)
  createdAt          DateTime            @default(now())
  applicantDocuments ApplicantDocument[]
}

model ApplicantDocument {
  id                 String           @id @default(cuid())
  submissionId       String
  submission         StageSubmission  @relation(fields: [submissionId], references: [id])
  uploadedDocumentId String
  uploadedDocument   UploadedDocument @relation(fields: [uploadedDocumentId], references: [id])
  status             String           @default("Submitted")
}

model ElectronicSignature {
  id           String          @id @default(cuid())
  submissionId String          @unique
  submission   StageSubmission @relation(fields: [submissionId], references: [id])
  typedName    String
  confirmed    Boolean
  signedAt     DateTime        @default(now())
  ipHash       String?
  userAgent    String?
}

model AdminNote {
  id            String         @id @default(cuid())
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id])
  adminEmail    String
  note          String
  createdAt     DateTime       @default(now())
}

model EmailNotification {
  id                String         @id @default(cuid())
  applicationId     String
  application       JobApplication @relation(fields: [applicationId], references: [id])
  toEmail           String
  template          String
  subject           String
  status            String
  providerMessageId String?
  failureReason     String?
  createdAt         DateTime       @default(now())
}

model Offer {
  id                    String         @id @default(cuid())
  applicationId         String         @unique
  application           JobApplication @relation(fields: [applicationId], references: [id])
  roleOffered           String
  salary                String
  startDate             DateTime
  workMode              String
  reportingManager      String?
  probationPeriod       String?
  offerExpiryDate       DateTime?
  specialConditions     String?
  status                String         @default("Draft")
  candidateDecisionAt   DateTime?
  candidateDecisionNote String?
  releasedAt            DateTime?
  releasedByAdminEmail  String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model EmploymentAgreement {
  id                   String         @id @default(cuid())
  applicationId        String         @unique
  application          JobApplication @relation(fields: [applicationId], references: [id])
  version              Int            @default(1)
  title                String         @default("Employment Agreement + Role Schedule")
  agreementText        String
  roleSchedule         Json
  status               String         @default("Draft")
  releasedAt           DateTime?
  releasedByAdminEmail String?
  candidateSubmittedAt DateTime?
  approvedAt           DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model AuditLog {
  id            String          @id @default(cuid())
  applicationId String?
  application   JobApplication? @relation(fields: [applicationId], references: [id])
  actorType     String
  actorRef      String?
  action        String
  metadata      Json?
  createdAt     DateTime        @default(now())
}

model ApplicationAccessCode {
  id                       String         @id @default(cuid())
  applicationId            String
  application              JobApplication @relation(fields: [applicationId], references: [id])
  codeHash                 String
  expiresAt                DateTime
  usedAt                   DateTime?
  verifiedSessionTokenHash String?
  sessionExpiresAt         DateTime?
  createdAt                DateTime       @default(now())
}

model ApplicationSequence {
  year      Int      @id
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}

model RateLimitEvent {
  id        String   @id @default(cuid())
  scope     String
  keyHash   String
  createdAt DateTime @default(now())

  @@index([scope, keyHash, createdAt])
}

enum HrRoleKey {
  ADMIN
  HR_ADMIN
  PAYROLL_ADMIN
  EMPLOYEE
}

enum HrUserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum HrTokenStatus {
  ACTIVE
  USED
  REVOKED
}

enum HrAssignmentStatus {
  ACTIVE
  SUSPENDED
  ENDED
  REVOKED
}

enum HrSupervisorAssignmentType {
  DIRECT_REPORT
  DEPARTMENT
  TEAM
  WORKFLOW
}

enum HrOutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  ABANDONED
}

enum HrRecordStatus {
  ACTIVE
  ARCHIVED
}

enum HrEmploymentStatus {
  DRAFT
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
  ARCHIVED
}

enum HrEmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  TEMPORARY
}

enum HrAddressType {
  HOME
  MAILING
  EMERGENCY
}

enum HrIdentifierType {
  NATIONAL_ID
  PASSPORT
  TAX_ID
  PENSION_ID
  WORK_PERMIT
  OTHER
}

enum HrLeaveUnit {
  DAYS
  HOURS
}

enum HrLeaveAccrualFrequency {
  NONE
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum HrLeaveRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  WITHDRAWN
}

enum HrLeaveLedgerType {
  OPENING
  ACCRUAL
  CARRY_OVER
  ADJUSTMENT
  REQUEST_RESERVED
  REQUEST_RELEASED
  LEAVE_TAKEN
  LEAVE_RESTORED
  EXPIRY
}

enum HrPayFrequency {
  MONTHLY
  BIWEEKLY
  WEEKLY
}

enum HrPayrollComponentType {
  EARNING
  DEDUCTION
  TAX
  BENEFIT
}

enum HrPayrollCalculationType {
  FIXED
  PERCENTAGE_OF_BASE
  PERCENTAGE_OF_GROSS
}

enum HrPayrollRunStatus {
  DRAFT
  CALCULATED
  REVIEWED
  APPROVED
  LOCKED
  PAID
  CANCELLED
}

enum HrPayrollPaymentStatus {
  NOT_PAID
  PROCESSING
  PAID
  FAILED
}

enum HrDocumentCategory {
  EMPLOYMENT_AGREEMENT
  OFFER_LETTER
  IDENTITY_DOCUMENT
  TAX_DOCUMENT
  BANK_DOCUMENT
  QUALIFICATION_CERTIFICATE
  POLICY_ACKNOWLEDGEMENT
  LEAVE_SUPPORT
  PERFORMANCE
  DISCIPLINARY
  EXIT_DOCUMENT
  OTHER
}

enum HrDocumentScanStatus {
  PENDING
  CLEAN
  QUARANTINED
  FAILED
}

enum HrDocumentRetentionStatus {
  ACTIVE
  HOLD
  EXPIRED
  PENDING_DELETION
}

enum HrAssetStatus {
  AVAILABLE
  ASSIGNED
  UNDER_REPAIR
  LOST
  RETIRED
  DISPOSED
}

enum HrAssetCondition {
  NEW
  GOOD
  FAIR
  DAMAGED
  UNUSABLE
}

enum HrAssetAssignmentStatus {
  ACTIVE
  RETURNED
  CANCELLED
  LOST
}

enum HrLifecycleType {
  ONBOARDING
  OFFBOARDING
}

enum HrLifecycleStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum HrLifecycleTaskOwnerType {
  HR
  IT
  SUPERVISOR
  EMPLOYEE
  PAYROLL
  SPECIFIC_USER
}

enum HrLifecycleTaskStatus {
  BLOCKED
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  CANCELLED
}

enum HrWorkflowApprovalMode {
  ANY
  ALL
  QUORUM
}

enum HrWorkflowAssigneeType {
  USERS
  SUPERVISOR
  PERMISSION
}

enum HrWorkflowInstanceStatus {
  ACTIVE
  APPROVED
  REJECTED
  CANCELLED
}

enum HrWorkflowStageRunStatus {
  PENDING
  ACTIVE
  APPROVED
  REJECTED
  SKIPPED
  CANCELLED
}

enum HrWorkflowDecision {
  APPROVED
  REJECTED
}

model HrOrganization {
  id                      String                      @id @default(cuid())
  slug                    String                      @unique
  name                    String
  registrationNumber      String?
  taxIdentificationNumber String?
  defaultCurrency         String                      @default("NGN")
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  users                   HrUser[]
  roles                   HrRole[]
  permissions             HrPermission[]
  employees               HrEmployee[]
  departments             HrDepartment[]
  teams                   HrTeam[]
  positions               HrPosition[]
  employeeAssignments     HrEmployeeAssignment[]
  leaveTypes              HrLeaveType[]
  leavePolicies           HrLeavePolicy[]
  leaveBalances           HrLeaveBalance[]
  leaveRequests           HrLeaveRequest[]
  publicHolidays          HrPublicHoliday[]
  salaryRecords           HrSalaryRecord[]
  payrollComponents       HrPayrollComponent[]
  payrollPeriods          HrPayrollPeriod[]
  payrollRuns             HrPayrollRun[]
  payrollItems            HrPayrollItem[]
  payrollExports          HrPayrollExport[]
  employeeDocuments       HrEmployeeDocument[]
  documentVersions        HrEmployeeDocumentVersion[]
  documentAccessLogs      HrDocumentAccessLog[]
  assets                  HrAsset[]
  assetAssignments        HrAssetAssignment[]
  lifecycleTemplates      HrLifecycleTemplate[]
  lifecycleInstances      HrLifecycleInstance[]
  lifecycleTasks          HrLifecycleTask[]
  workflowDefinitions     HrWorkflowDefinition[]
  workflowInstances       HrWorkflowInstance[]
  workflowStageRuns       HrWorkflowStageRun[]
  supervisorAssignments   HrSupervisorAssignment[]
  auditEvents             HrAuditEvent[]
  emailOutbox             HrEmailOutbox[]
  settings                HrOrganizationSetting[]
}

model HrUser {
  id                         String                       @id @default(cuid())
  organizationId             String
  organization               HrOrganization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email                      String
  passwordHash               String?
  status                     HrUserStatus                 @default(INVITED)
  emailVerifiedAt            DateTime?
  lastLoginAt                DateTime?
  suspendedAt                DateTime?
  mfaEnabled                 Boolean                      @default(false)
  mfaSecretEncrypted         String?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  roles                      HrUserRole[]
  sessions                   HrSession[]
  invitationsCreated         HrAccountInvitation[]        @relation("InvitationCreator")
  invitationsReceived        HrAccountInvitation[]        @relation("InvitationRecipient")
  passwordResets             HrPasswordResetToken[]
  loginAttempts              HrLoginAttempt[]
  employee                   HrEmployee?
  assignmentsGranted         HrSupervisorAssignment[]     @relation("SupervisorAssignmentGrantor")
  assignmentsEnded           HrSupervisorAssignment[]     @relation("SupervisorAssignmentEnder")
  employeeAssignmentsCreated HrEmployeeAssignment[]       @relation("EmployeeAssignmentCreator")
  employeeAssignmentsEnded   HrEmployeeAssignment[]       @relation("EmployeeAssignmentEnder")
  leaveRequestsCreated       HrLeaveRequest[]             @relation("LeaveRequester")
  leaveRequestsToReview      HrLeaveRequest[]             @relation("LeaveCurrentReviewer")
  leaveApprovals             HrLeaveApproval[]            @relation("LeaveReviewer")
  leavePoliciesAssigned      HrEmployeeLeavePolicy[]      @relation("LeavePolicyAssigner")
  leavePoliciesEnded         HrEmployeeLeavePolicy[]      @relation("LeavePolicyEnder")
  leaveLedgerEntries         HrLeaveLedger[]
  leaveAttachmentsUploaded   HrLeaveAttachment[]
  salaryChangesCreated       HrSalaryRecord[]             @relation("SalaryRecordCreator")
  salaryChangesApproved      HrSalaryRecord[]             @relation("SalaryRecordApprover")
  payrollRunsCreated         HrPayrollRun[]               @relation("PayrollRunCreator")
  payrollApprovals           HrPayrollApproval[]
  payrollAdjustmentsCreated  HrPayrollAdjustment[]
  payrollComponentsCreated   HrEmployeePayrollComponent[]
  payrollPaymentsMarked      HrPayrollItem[]              @relation("PayrollPaymentMarker")
  payrollExportsCreated      HrPayrollExport[]
  documentsCreated           HrEmployeeDocument[]         @relation("DocumentCreator")
  documentVersionsUploaded   HrEmployeeDocumentVersion[]  @relation("DocumentVersionUploader")
  documentScansRecorded      HrEmployeeDocumentVersion[]  @relation("DocumentScanRecorder")
  documentsArchived          HrEmployeeDocument[]         @relation("DocumentArchiver")
  documentAccessLogs         HrDocumentAccessLog[]
  assetsCreated              HrAsset[]                    @relation("AssetCreator")
  assetAssignmentsCreated    HrAssetAssignment[]          @relation("AssetAssignmentCreator")
  assetReturnsRecorded       HrAssetAssignment[]          @relation("AssetReturnRecorder")
  lifecycleInstancesCreated  HrLifecycleInstance[]        @relation("LifecycleInstanceCreator")
  lifecycleTasksAssigned     HrLifecycleTask[]            @relation("LifecycleTaskAssignee")
  lifecycleTasksCompleted    HrLifecycleTask[]            @relation("LifecycleTaskCompleter")
  workflowDefinitionsCreated HrWorkflowDefinition[]       @relation("WorkflowDefinitionCreator")
  workflowInstancesStarted   HrWorkflowInstance[]         @relation("WorkflowInstanceStarter")
  workflowApprovals          HrWorkflowApproval[]
  auditEvents                HrAuditEvent[]

  @@unique([organizationId, email])
  @@index([organizationId, status])
}

model HrRole {
  id             String             @id @default(cuid())
  organizationId String
  organization   HrOrganization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            HrRoleKey
  name           String
  description    String?
  system         Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  users          HrUserRole[]
  permissions    HrRolePermission[]

  @@unique([organizationId, key])
}

model HrPermission {
  id             String             @id @default(cuid())
  organizationId String
  organization   HrOrganization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  description    String?
  createdAt      DateTime           @default(now())
  roles          HrRolePermission[]

  @@unique([organizationId, key])
}

model HrUserRole {
  id           String    @id @default(cuid())
  userId       String
  roleId       String
  assignedById String?
  assignedAt   DateTime  @default(now())
  revokedAt    DateTime?
  user         HrUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         HrRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId, revokedAt])
}

model HrRolePermission {
  id           String       @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime     @default(now())
  role         HrRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   HrPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model HrSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  ipHash     String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  user       HrUser    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt, revokedAt])
}

model HrAccountInvitation {
  id             String        @id @default(cuid())
  organizationId String
  userId         String
  tokenHash      String        @unique
  status         HrTokenStatus @default(ACTIVE)
  expiresAt      DateTime
  usedAt         DateTime?
  createdById    String
  createdAt      DateTime      @default(now())
  user           HrUser        @relation("InvitationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  createdBy      HrUser        @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, userId, status, expiresAt])
}

model HrPasswordResetToken {
  id        String        @id @default(cuid())
  userId    String
  tokenHash String        @unique
  status    HrTokenStatus @default(ACTIVE)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      HrUser        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
}

model HrLoginAttempt {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  emailHash      String
  ipHash         String
  succeeded      Boolean  @default(false)
  reason         String?
  createdAt      DateTime @default(now())
  user           HrUser?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, emailHash, ipHash, createdAt])
}

model HrEmployee {
  id                           String                       @id @default(cuid())
  organizationId               String
  recruitmentApplicationId     String?                      @unique
  userId                       String?                      @unique
  employeeNumber               String
  legalFirstName               String
  middleName                   String?
  lastName                     String
  preferredName                String?
  companyEmail                 String?
  personalEmail                String?
  phone                        String?
  dateOfBirth                  DateTime?
  employmentStatus             HrEmploymentStatus           @default(DRAFT)
  hireDate                     DateTime?
  terminationDate              DateTime?
  terminationReason            String?
  archivedAt                   DateTime?
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt
  organization                 HrOrganization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recruitmentApplication       JobApplication?              @relation(fields: [recruitmentApplicationId], references: [id], onDelete: SetNull)
  user                         HrUser?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  supervisedAssignments        HrSupervisorAssignment[]     @relation("SupervisorEmployee")
  assignedToAssignments        HrSupervisorAssignment[]     @relation("AssignedEmployee")
  employmentAssignments        HrEmployeeAssignment[]
  addresses                    HrEmployeeAddress[]
  emergencyContacts            HrEmergencyContact[]
  identifiers                  HrEmployeeIdentifier[]
  bankAccounts                 HrEmployeeBankAccount[]
  taxProfile                   HrEmployeeTaxProfile?
  departmentsLed               HrDepartment[]               @relation("DepartmentHead")
  leavePolicyAssignments       HrEmployeeLeavePolicy[]
  leaveBalances                HrLeaveBalance[]
  leaveRequests                HrLeaveRequest[]
  salaryRecords                HrSalaryRecord[]
  payrollComponentAssignments  HrEmployeePayrollComponent[]
  payrollItems                 HrPayrollItem[]
  payrollAdjustments           HrPayrollAdjustment[]
  documents                    HrEmployeeDocument[]
  assetAssignments             HrAssetAssignment[]
  lifecycleInstances           HrLifecycleInstance[]
  knowledgeTransferAssignments HrLifecycleInstance[]        @relation("LifecycleKnowledgeTransfer")
  workflowSubjects             HrWorkflowInstance[]

  @@unique([organizationId, employeeNumber])
  @@unique([organizationId, companyEmail])
  @@index([organizationId, lastName, legalFirstName])
}

model HrDepartment {
  id                    String                   @id @default(cuid())
  organizationId        String
  code                  String
  name                  String
  description           String?
  status                HrRecordStatus           @default(ACTIVE)
  headEmployeeId        String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  archivedAt            DateTime?
  organization          HrOrganization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  headEmployee          HrEmployee?              @relation("DepartmentHead", fields: [headEmployeeId], references: [id], onDelete: SetNull)
  teams                 HrTeam[]
  positions             HrPosition[]
  employeeAssignments   HrEmployeeAssignment[]
  supervisorAssignments HrSupervisorAssignment[]

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@index([organizationId, status, name])
}

model HrTeam {
  id             String                 @id @default(cuid())
  organizationId String
  departmentId   String
  code           String
  name           String
  description    String?
  status         HrRecordStatus         @default(ACTIVE)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  archivedAt     DateTime?
  organization   HrOrganization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department     HrDepartment           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  positions      HrPosition[]
  assignments    HrEmployeeAssignment[]

  @@unique([organizationId, code])
  @@unique([departmentId, name])
  @@index([organizationId, status, name])
}

model HrPosition {
  id                  String                 @id @default(cuid())
  organizationId      String
  departmentId        String
  teamId              String?
  code                String
  title               String
  description         String?
  salaryBandMinimum   Decimal?               @db.Decimal(18, 2)
  salaryBandMaximum   Decimal?               @db.Decimal(18, 2)
  currency            String                 @default("NGN")
  status              HrRecordStatus         @default(ACTIVE)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  archivedAt          DateTime?
  organization        HrOrganization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department          HrDepartment           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  team                HrTeam?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  employeeAssignments HrEmployeeAssignment[]

  @@unique([organizationId, code])
  @@index([organizationId, status, title])
  @@index([departmentId, teamId])
}

model HrEmployeeAssignment {
  id             String             @id @default(cuid())
  organizationId String
  employeeId     String
  departmentId   String
  teamId         String?
  positionId     String
  employmentType HrEmploymentType
  location       String?
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  status         HrAssignmentStatus @default(ACTIVE)
  reason         String
  createdById    String
  endedById      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  endedAt        DateTime?
  organization   HrOrganization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee       HrEmployee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  department     HrDepartment       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  team           HrTeam?            @relation(fields: [teamId], references: [id], onDelete: Restrict)
  position       HrPosition         @relation(fields: [positionId], references: [id], onDelete: Restrict)
  createdBy      HrUser             @relation("EmployeeAssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  endedBy        HrUser?            @relation("EmployeeAssignmentEnder", fields: [endedById], references: [id], onDelete: Restrict)

  @@index([organizationId, employeeId, status, effectiveFrom, effectiveTo])
  @@index([departmentId, positionId, status])
}

model HrEmployeeAddress {
  id         String        @id @default(cuid())
  employeeId String
  type       HrAddressType
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String?
  country    String
  isPrimary  Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  employee   HrEmployee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, type, isPrimary])
}

model HrEmergencyContact {
