model HrOrganization {
  id                         String                            @id @default(cuid())
  slug                       String                            @unique
  name                       String
  registrationNumber         String?
  taxIdentificationNumber    String?
  defaultCurrency            String                            @default("NGN")
  createdAt                  DateTime                          @default(now())
  updatedAt                  DateTime                          @updatedAt
  users                      HrUser[]
  roles                      HrRole[]
  permissions                HrPermission[]
  employees                  HrEmployee[]
  departments                HrDepartment[]
  teams                      HrTeam[]
  positions                  HrPosition[]
  employeeAssignments        HrEmployeeAssignment[]
  leaveTypes                 HrLeaveType[]
  leavePolicies              HrLeavePolicy[]
  leaveBalances              HrLeaveBalance[]
  leaveRequests              HrLeaveRequest[]
  publicHolidays             HrPublicHoliday[]
  salaryRecords              HrSalaryRecord[]
  payrollComponents          HrPayrollComponent[]
  payrollPeriods             HrPayrollPeriod[]
  payrollRuns                HrPayrollRun[]
  payrollItems               HrPayrollItem[]
  payrollExports             HrPayrollExport[]
  employeeDocuments          HrEmployeeDocument[]
  documentVersions           HrEmployeeDocumentVersion[]
  documentAccessLogs         HrDocumentAccessLog[]
  assets                     HrAsset[]
  assetAssignments           HrAssetAssignment[]
  lifecycleTemplates         HrLifecycleTemplate[]
  lifecycleInstances         HrLifecycleInstance[]
  lifecycleTasks             HrLifecycleTask[]
  workflowDefinitions        HrWorkflowDefinition[]
  workflowInstances          HrWorkflowInstance[]
  workflowStageRuns          HrWorkflowStageRun[]
  recruitmentApplications    JobApplication[]
  supervisorAssignments      HrSupervisorAssignment[]
  auditEvents                HrAuditEvent[]
  emailOutbox                HrEmailOutbox[]
  notifications              HrNotification[]
  notificationPreferences    HrNotificationPreference[]
  settings                   HrOrganizationSetting[]
  employeeNumberSequences    HrEmployeeNumberSequence[]
  employeeStatusHistory      HrEmployeeStatusHistory[]
  systemAccessAssignments    HrSystemAccessAssignment[]
  employeeProvisioningDrafts HrEmployeeProvisioningDraft[]
  legalEntities              HrLegalEntity[]
  businessUnits              HrBusinessUnit[]
  divisions                  HrDivision[]
  locations                  HrLocation[]
  costCenters                HrCostCenter[]
  jobFamilies                HrJobFamily[]
  jobProfiles                HrJobProfile[]
  grades                     HrGrade[]
  positionApprovals          HrPositionApproval[]
  organizationChanges        HrOrganizationChange[]
  organizationImportBatches  HrOrganizationImportBatch[]
  organizationRevisions      HrOrganizationStructureRevision[]
  hiringTeams                HrHiringTeam[]
  hiringTeamDefaults         HrDepartmentHiringTeamDefault[]
  recruitmentRoutingRules    HrRecruitmentRoutingRule[]
  recruitmentFallbackQueues  HrRecruitmentFallbackQueue[]
  vacancies                  HrVacancy[]
  vacancyNumberSequences     HrVacancyNumberSequence[]
  people                     HrPerson[]
  workRelationships          HrWorkRelationship[]
  workforceEvents            HrWorkforceEvent[]
  profileChangeRequests      HrProfileChangeRequest[]
}

model HrUser {
  id                               String                          @id @default(cuid())
  organizationId                   String
  organization                     HrOrganization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email                            String
  passwordHash                     String?
  status                           HrUserStatus                    @default(INVITED)
  emailVerifiedAt                  DateTime?
  lastLoginAt                      DateTime?
  suspendedAt                      DateTime?
  mfaEnabled                       Boolean                         @default(false)
  mfaSecretEncrypted               String?
  mfaLastUsedStep                  BigInt?
  isPrimaryAdmin                   Boolean                         @default(false)
  deletedAt                        DateTime?
  deletedById                      String?
  createdAt                        DateTime                        @default(now())
  updatedAt                        DateTime                        @updatedAt
  roles                            HrUserRole[]
  sessions                         HrSession[]
  invitationsCreated               HrAccountInvitation[]           @relation("InvitationCreator")
  invitationsReceived              HrAccountInvitation[]           @relation("InvitationRecipient")
  passwordResets                   HrPasswordResetToken[]
  loginAttempts                    HrLoginAttempt[]
  employee                         HrEmployee?
  assignmentsGranted               HrSupervisorAssignment[]        @relation("SupervisorAssignmentGrantor")
  assignmentsEnded                 HrSupervisorAssignment[]        @relation("SupervisorAssignmentEnder")
  employeeAssignmentsCreated       HrEmployeeAssignment[]          @relation("EmployeeAssignmentCreator")
  employeeAssignmentsEnded         HrEmployeeAssignment[]          @relation("EmployeeAssignmentEnder")
  leaveRequestsCreated             HrLeaveRequest[]                @relation("LeaveRequester")
  leaveRequestsToReview            HrLeaveRequest[]                @relation("LeaveCurrentReviewer")
  leaveApprovals                   HrLeaveApproval[]               @relation("LeaveReviewer")
  leavePoliciesAssigned            HrEmployeeLeavePolicy[]         @relation("LeavePolicyAssigner")
  leavePoliciesEnded               HrEmployeeLeavePolicy[]         @relation("LeavePolicyEnder")
  leaveLedgerEntries               HrLeaveLedger[]
  leaveAttachmentsUploaded         HrLeaveAttachment[]
  salaryChangesCreated             HrSalaryRecord[]                @relation("SalaryRecordCreator")
  salaryChangesApproved            HrSalaryRecord[]                @relation("SalaryRecordApprover")
  payrollRunsCreated               HrPayrollRun[]                  @relation("PayrollRunCreator")
  payrollApprovals                 HrPayrollApproval[]
  payrollAdjustmentsCreated        HrPayrollAdjustment[]
  payrollComponentsCreated         HrEmployeePayrollComponent[]
  payrollPaymentsMarked            HrPayrollItem[]                 @relation("PayrollPaymentMarker")
  payrollExportsCreated            HrPayrollExport[]
  documentsCreated                 HrEmployeeDocument[]            @relation("DocumentCreator")
  documentVersionsUploaded         HrEmployeeDocumentVersion[]     @relation("DocumentVersionUploader")
  documentScansRecorded            HrEmployeeDocumentVersion[]     @relation("DocumentScanRecorder")
  documentsArchived                HrEmployeeDocument[]            @relation("DocumentArchiver")
  documentAccessLogs               HrDocumentAccessLog[]
  assetsCreated                    HrAsset[]                       @relation("AssetCreator")
  assetAssignmentsCreated          HrAssetAssignment[]             @relation("AssetAssignmentCreator")
  assetReturnsRecorded             HrAssetAssignment[]             @relation("AssetReturnRecorder")
  lifecycleInstancesCreated        HrLifecycleInstance[]           @relation("LifecycleInstanceCreator")
  lifecycleTasksAssigned           HrLifecycleTask[]               @relation("LifecycleTaskAssignee")
  lifecycleTasksCompleted          HrLifecycleTask[]               @relation("LifecycleTaskCompleter")
  workflowDefinitionsCreated       HrWorkflowDefinition[]          @relation("WorkflowDefinitionCreator")
  workflowInstancesStarted         HrWorkflowInstance[]            @relation("WorkflowInstanceStarter")
  workflowApprovals                HrWorkflowApproval[]
  auditEvents                      HrAuditEvent[]
  notifications                    HrNotification[]
  notificationPreferences          HrNotificationPreference[]
  employeeStatusChanges            HrEmployeeStatusHistory[]
  systemAccessAssignmentsCreated   HrSystemAccessAssignment[]      @relation("SystemAccessCreator")
  systemAccessAssignmentsEnded     HrSystemAccessAssignment[]      @relation("SystemAccessEnder")
  provisioningDraftsCreated        HrEmployeeProvisioningDraft[]   @relation("ProvisioningDraftCreator")
  provisioningDraftsUpdated        HrEmployeeProvisioningDraft[]   @relation("ProvisioningDraftUpdater")
  provisioningDraftsFinalized      HrEmployeeProvisioningDraft[]   @relation("ProvisioningDraftFinalizer")
  hiringTeamsCreated               HrHiringTeam[]                  @relation("HiringTeamCreator")
  hiringTeamMemberships            HrHiringTeamMember[]            @relation("HiringTeamMemberUser")
  hiringTeamMembersAdded           HrHiringTeamMember[]            @relation("HiringTeamMemberAdder")
  hiringTeamPermissionsGranted     HrHiringTeamMemberPermission[]  @relation("HiringTeamPermissionGrantor")
  hiringTeamDefaultsConfigured     HrDepartmentHiringTeamDefault[] @relation("HiringTeamDefaultConfigurator")
  recruitmentRoutingRulesCreated   HrRecruitmentRoutingRule[]      @relation("RecruitmentRoutingRuleCreator")
  recruitmentRoutingAssignments    HrRecruitmentRoutingRule[]      @relation("RecruitmentRoutingOwner")
  recruitmentFallbackQueuesCreated HrRecruitmentFallbackQueue[]    @relation("RecruitmentFallbackQueueCreator")
  recruitmentFallbackAssignments   HrRecruitmentFallbackQueue[]    @relation("RecruitmentFallbackOwner")
  vacanciesCreated                 HrVacancy[]                     @relation("VacancyCreator")
  vacanciesUpdated                 HrVacancy[]                     @relation("VacancyUpdater")
  vacanciesOwned                   HrVacancy[]                     @relation("VacancyOwner")
  vacanciesManaged                 HrVacancy[]                     @relation("VacancyHiringManager")
  vacancyApprovals                 HrVacancyApproval[]
  vacancyHistoryEvents             HrVacancyHistory[]

  @@unique([organizationId, email])
  @@index([organizationId, status])
}

model HrRole {
  id             String             @id @default(cuid())
  organizationId String
  organization   HrOrganization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            HrRoleKey
  name           String
  description    String?
  system         Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  users          HrUserRole[]
  permissions    HrRolePermission[]

  @@unique([organizationId, key])
}

model HrPermission {
  id             String             @id @default(cuid())
  organizationId String
  organization   HrOrganization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  description    String?
  createdAt      DateTime           @default(now())
  roles          HrRolePermission[]

  @@unique([organizationId, key])
}

model HrUserRole {
  id           String    @id @default(cuid())
  userId       String
  roleId       String
  assignedById String?
  assignedAt   DateTime  @default(now())
  revokedAt    DateTime?
  user         HrUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         HrRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId, revokedAt])
}

model HrRolePermission {
  id           String       @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime     @default(now())
  role         HrRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   HrPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model HrSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  ipHash     String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  user       HrUser    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt, revokedAt])
}

model HrAccountInvitation {
  id             String        @id @default(cuid())
  organizationId String
  userId         String
  tokenHash      String        @unique
  status         HrTokenStatus @default(ACTIVE)
  expiresAt      DateTime
  usedAt         DateTime?
  createdById    String
  createdAt      DateTime      @default(now())
  user           HrUser        @relation("InvitationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  createdBy      HrUser        @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, userId, status, expiresAt])
}

model HrPasswordResetToken {
  id        String        @id @default(cuid())
  userId    String
  tokenHash String        @unique
  status    HrTokenStatus @default(ACTIVE)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      HrUser        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
}

model HrLoginAttempt {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  emailHash      String
  ipHash         String
  succeeded      Boolean  @default(false)
  reason         String?
  createdAt      DateTime @default(now())
  user           HrUser?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, emailHash, ipHash, createdAt])
  @@index([succeeded, createdAt])
}

model HrEmployee {
  id                           String                       @id @default(cuid())
  organizationId               String
  recruitmentApplicationId     String?                      @unique
  userId                       String?                      @unique
  employeeNumber               String
  legalFirstName               String
  middleName                   String?
  lastName                     String
  preferredName                String?
  companyEmail                 String?
  personalEmail                String?
  preferredNotificationEmail   String?
  companyEmailStatus           HrCompanyEmailStatus         @default(PENDING)
  phone                        String?
  dateOfBirth                  DateTime?
  employmentStatus             HrEmploymentStatus           @default(DRAFT)
  hireDate                     DateTime?
  startDate                    DateTime?
  workMode                     HrWorkMode?
  probationEndDate             DateTime?
  confirmationDate             DateTime?
  noticePeriodStartDate        DateTime?
  terminationDate              DateTime?
  terminationReason            String?
  notes                        String?
  archivedAt                   DateTime?
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt
  organization                 HrOrganization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recruitmentApplication       JobApplication?              @relation(fields: [recruitmentApplicationId], references: [id], onDelete: SetNull)
  user                         HrUser?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  supervisedAssignments        HrSupervisorAssignment[]     @relation("SupervisorEmployee")
  assignedToAssignments        HrSupervisorAssignment[]     @relation("AssignedEmployee")
  employmentAssignments        HrEmployeeAssignment[]
  addresses                    HrEmployeeAddress[]
  emergencyContacts            HrEmergencyContact[]
  identifiers                  HrEmployeeIdentifier[]
  bankAccounts                 HrEmployeeBankAccount[]
  taxProfile                   HrEmployeeTaxProfile?
  departmentsLed               HrDepartment[]               @relation("DepartmentHead")
  leavePolicyAssignments       HrEmployeeLeavePolicy[]
  leaveBalances                HrLeaveBalance[]
  leaveRequests                HrLeaveRequest[]
  salaryRecords                HrSalaryRecord[]
  payrollComponentAssignments  HrEmployeePayrollComponent[]
  payrollItems                 HrPayrollItem[]
  payrollAdjustments           HrPayrollAdjustment[]
  documents                    HrEmployeeDocument[]
  assetAssignments             HrAssetAssignment[]
  lifecycleInstances           HrLifecycleInstance[]
  knowledgeTransferAssignments HrLifecycleInstance[]        @relation("LifecycleKnowledgeTransfer")
  workflowSubjects             HrWorkflowInstance[]
  statusHistory                HrEmployeeStatusHistory[]
  systemAccessAssignments      HrSystemAccessAssignment[]
  provisioningDraft            HrEmployeeProvisioningDraft?
  personId                     String?
  person                       HrPerson?                    @relation(fields: [personId], references: [id], onDelete: Restrict)
  workRelationships            HrWorkRelationship[]
  workforceEvents              HrWorkforceEvent[]
  profileChangeRequests        HrProfileChangeRequest[]

  @@unique([organizationId, employeeNumber])
  @@unique([organizationId, companyEmail])
  @@index([organizationId, lastName, legalFirstName])
  @@index([organizationId, personId])
}

model HrEmployeeProvisioningDraft {
  id                  String         @id @default(cuid())
  organizationId      String
  status              String         @default("DRAFT")
  currentStep         Int            @default(1)
  version             Int            @default(1)
  payload             Json
  readinessScore      Int            @default(0)
  submittedAt         DateTime?
  finalizedAt         DateTime?
  cancelledAt         DateTime?
  createdById         String
  updatedById         String
  finalizedById       String?
  finalizedEmployeeId String?        @unique
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  organization        HrOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy           HrUser         @relation("ProvisioningDraftCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy           HrUser         @relation("ProvisioningDraftUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  finalizedBy         HrUser?        @relation("ProvisioningDraftFinalizer", fields: [finalizedById], references: [id], onDelete: Restrict)
  finalizedEmployee   HrEmployee?    @relation(fields: [finalizedEmployeeId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, updatedAt])
  @@index([createdById, status])
}

model HrEmployeeNumberSequence {
  id             String         @id @default(cuid())
  organizationId String
  year           Int
  lastValue      Int
  updatedAt      DateTime       @updatedAt
  organization   HrOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, year])
}

model HrEmployeeStatusHistory {
  id             String              @id @default(cuid())
  organizationId String
  employeeId     String
  previousStatus HrEmploymentStatus?
  newStatus      HrEmploymentStatus
  effectiveAt    DateTime
  reason         String
  changedById    String
  createdAt      DateTime            @default(now())
  organization   HrOrganization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee       HrEmployee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  changedBy      HrUser              @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([employeeId, effectiveAt])
  @@index([organizationId, newStatus, effectiveAt])
}

model HrSystemAccessAssignment {
  id             String               @id @default(cuid())
  organizationId String
  employeeId     String
  systemKey      String
  displayName    String
  accountRef     String?
  status         HrSystemAccessStatus @default(REQUESTED)
  assignedAt     DateTime?
  expectedEndAt  DateTime?
  endedAt        DateTime?
  createdById    String
  endedById      String?
  reason         String
  endReason      String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   HrOrganization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee       HrEmployee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy      HrUser               @relation("SystemAccessCreator", fields: [createdById], references: [id], onDelete: Restrict)
  endedBy        HrUser?              @relation("SystemAccessEnder", fields: [endedById], references: [id], onDelete: Restrict)

  @@index([employeeId, systemKey, status])
  @@index([organizationId, status, expectedEndAt])
}

model HrDepartment {
  id                      String                         @id @default(cuid())
  organizationId          String
  code                    String
  name                    String
  description             String?
  status                  HrRecordStatus                 @default(ACTIVE)
  headEmployeeId          String?
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  archivedAt              DateTime?
  organization            HrOrganization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  headEmployee            HrEmployee?                    @relation("DepartmentHead", fields: [headEmployeeId], references: [id], onDelete: SetNull)
  teams                   HrTeam[]
  positions               HrPosition[]
  employeeAssignments     HrEmployeeAssignment[]
  supervisorAssignments   HrSupervisorAssignment[]
  hiringTeams             HrHiringTeam[]
  hiringTeamDefault       HrDepartmentHiringTeamDefault?
  recruitmentRoutingRules HrRecruitmentRoutingRule[]
  vacancies               HrVacancy[]

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@index([organizationId, status, name])
}

model HrTeam {
  id                    String                   @id @default(cuid())
  organizationId        String
  departmentId          String
  code                  String
  name                  String
  description           String?
  status                HrRecordStatus           @default(ACTIVE)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  archivedAt            DateTime?
  organization          HrOrganization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department            HrDepartment             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  positions             HrPosition[]
  assignments           HrEmployeeAssignment[]
  supervisorAssignments HrSupervisorAssignment[]

  @@unique([organizationId, code])
  @@unique([departmentId, name])
  @@index([organizationId, status, name])
}

model HrPosition {
  id                  String                    @id @default(cuid())
  organizationId      String
  departmentId        String
  teamId              String?
  code                String
  title               String
  description         String?
  salaryBandMinimum   Decimal?                  @db.Decimal(18, 2)
  salaryBandMaximum   Decimal?                  @db.Decimal(18, 2)
  currency            String                    @default("NGN")
  status              HrRecordStatus            @default(ACTIVE)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  archivedAt          DateTime?
  legalEntityId       String?
  businessUnitId      String?
  divisionId          String?
  locationId          String?
  costCenterId        String?
  jobProfileId        String?
  gradeId             String?
  reportsToPositionId String?
  lifecycleStatus     HrPositionLifecycleStatus @default(DRAFT)
  headcountLimit      Int                       @default(1)
  fullTimeEquivalent  Decimal                   @default(1) @db.Decimal(5, 2)
  budgetedAmount      Decimal?                  @db.Decimal(18, 2)
  availableFrom       DateTime?
  effectiveFrom       DateTime                  @default(now())
  effectiveTo         DateTime?
  version             Int                       @default(1)
  requestedById       String?
  approvedById        String?
  approvedAt          DateTime?
  organization        HrOrganization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department          HrDepartment              @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  team                HrTeam?                   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  employeeAssignments HrEmployeeAssignment[]
  approvals           HrPositionApproval[]

  @@unique([organizationId, code])
  @@index([organizationId, status, title])
  @@index([departmentId, teamId])
}

model HrEmployeeAssignment {
  id                String             @id @default(cuid())
  organizationId    String
  employeeId        String
  departmentId      String
  teamId            String?
  positionId        String
  employmentType    HrEmploymentType
  location          String?
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  status            HrAssignmentStatus @default(ACTIVE)
  reason            String
  createdById       String
  endedById         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  endedAt           DateTime?
  legalEntityId     String?
  businessUnitId    String?
  divisionId        String?
  locationId        String?
  costCenterId      String?
  isPrimary         Boolean            @default(true)
  fte               Decimal            @default(1) @db.Decimal(5, 2)
  placementSnapshot Json?
  version           Int                @default(1)
  organization      HrOrganization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee          HrEmployee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  department        HrDepartment       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  team              HrTeam?            @relation(fields: [teamId], references: [id], onDelete: Restrict)
  position          HrPosition         @relation(fields: [positionId], references: [id], onDelete: Restrict)
  createdBy         HrUser             @relation("EmployeeAssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  endedBy           HrUser?            @relation("EmployeeAssignmentEnder", fields: [endedById], references: [id], onDelete: Restrict)

  @@index([organizationId, employeeId, status, effectiveFrom, effectiveTo])
  @@index([departmentId, positionId, status])
}

model HrPerson {
  id              String               @id @default(cuid())
  organizationId  String
  identityKeyHash String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  organization    HrOrganization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employees       HrEmployee[]
  relationships   HrWorkRelationship[]

  @@unique([organizationId, identityKeyHash])
  @@index([organizationId, createdAt])
}

model HrWorkRelationship {
  id              String                   @id @default(cuid())
  organizationId  String
  personId        String
  employeeId      String
  relationshipRef String
  status          HrWorkRelationshipStatus @default(ACTIVE)
  startedAt       DateTime
  noticeDate      DateTime?
  endedAt         DateTime?
  endReason       String?
  rehireOfId      String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  organization    HrOrganization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  person          HrPerson                 @relation(fields: [personId], references: [id], onDelete: Restrict)
  employee        HrEmployee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  rehireOf        HrWorkRelationship?      @relation("WorkRelationshipRehire", fields: [rehireOfId], references: [id], onDelete: Restrict)
  rehires         HrWorkRelationship[]      @relation("WorkRelationshipRehire")
  workforceEvents HrWorkforceEvent[]

  @@unique([organizationId, relationshipRef])
  @@index([organizationId, personId, status])
  @@index([employeeId, status, startedAt, endedAt])
}

model HrWorkforceEvent {
  id                   String                 @id @default(cuid())
  organizationId       String
  employeeId           String
  workRelationshipId   String?
  reference            String
  type                 HrWorkforceEventType
  status               HrWorkforceEventStatus @default(DRAFT)
  version              Int                    @default(1)
  reason               String
  currentSnapshot      Json
  proposedSnapshot     Json
  requestedEffectiveAt DateTime
  initiatedById        String
  ownerUserId          String?
  workflowInstanceId   String?
  idempotencyKey       String
  correlationId        String
  submittedAt          DateTime?
  approvedAt           DateTime?
  scheduledAt          DateTime?
  appliedAt            DateTime?
  cancelledAt          DateTime?
  failedAt             DateTime?
  failureReason        String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  organization         HrOrganization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee             HrEmployee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  workRelationship     HrWorkRelationship?    @relation(fields: [workRelationshipId], references: [id], onDelete: Restrict)
  versions             HrWorkforceEventVersion[]
  executionAttempts    HrWorkforceEventExecutionAttempt[]

  @@unique([organizationId, reference])
  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, correlationId])
  @@index([organizationId, status, requestedEffectiveAt])
  @@index([employeeId, status, requestedEffectiveAt])
}

model HrWorkforceEventVersion {
  id                 String           @id @default(cuid())
  eventId            String
  version            Int
  currentSnapshot    Json
  proposedSnapshot   Json
  reason             String
  evidenceVersionIds String[]         @default([])
  createdById        String
  createdAt          DateTime         @default(now())
  event              HrWorkforceEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([eventId, version])
  @@index([eventId, createdAt])
}

model HrWorkforceEventExecutionAttempt {
  id             String           @id @default(cuid())
  eventId        String
  eventVersion   Int
  attemptNumber  Int
  claimTokenHash String           @unique
  status         String
  safeError      String?
  startedAt      DateTime         @default(now())
  completedAt    DateTime?
  event          HrWorkforceEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([eventId, eventVersion, attemptNumber])
  @@index([status, startedAt])
}

model HrProfileChangeRequest {
  id                     String                       @id @default(cuid())
  organizationId         String
  employeeId             String
  status                 HrProfileChangeRequestStatus @default(DRAFT)
  version                Int                          @default(1)
  fieldKey               String
  currentValueRedacted   Json?
  proposedValueEncrypted String?
  proposedValueRedacted  Json
  effectiveAt            DateTime?
  evidenceVersionIds     String[]                     @default([])
  requestedById          String
  reviewedById           String?
  reviewReason           String?
  submittedAt            DateTime?
  reviewedAt             DateTime?
  appliedAt              DateTime?
  cancelledAt            DateTime?
  correlationId          String
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  organization           HrOrganization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee               HrEmployee                   @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([organizationId, correlationId])
  @@index([organizationId, status, createdAt])
  @@index([employeeId, fieldKey, status])
}

model HrEmployeeAddress {
  id         String        @id @default(cuid())
  employeeId String
  type       HrAddressType
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String?
  country    String
  isPrimary  Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  employee   HrEmployee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, type, isPrimary])
}

model HrEmergencyContact {
  id           String     @id @default(cuid())
  employeeId   String
  fullName     String
  relationship String
  phone        String
  email        String?
  isPrimary    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  employee     HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, isPrimary])
}

model HrEmployeeIdentifier {
  id             String           @id @default(cuid())
  employeeId     String
  type           HrIdentifierType
  valueEncrypted String
  valueLastFour  String?
  issuingCountry String?
  issuedAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  employee       HrEmployee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, type])
  @@index([employeeId, expiresAt])
}

model HrEmployeeBankAccount {
  id                     String     @id @default(cuid())
  employeeId             String
  bankName               String
  accountName            String
  accountNumberEncrypted String
  accountNumberLastFour  String
  currency               String     @default("NGN")
  isPrimary              Boolean    @default(true)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  employee               HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, isPrimary])
}

model HrEmployeeTaxProfile {
  id                         String     @id @default(cuid())
  employeeId                 String     @unique
  taxCountry                 String
  taxIdentifierEncrypted     String?
  taxIdentifierLastFour      String?
  pensionProvider            String?
  pensionIdentifierEncrypted String?
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt
  employee                   HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model HrSupervisorAssignment {
  id                   String                     @id @default(cuid())
  organizationId       String
  supervisorEmployeeId String
  assignedEmployeeId   String?
  departmentScopeId    String?
  teamScopeId          String?
  assignmentType       HrSupervisorAssignmentType
  status               HrAssignmentStatus         @default(ACTIVE)
  effectiveFrom        DateTime
  effectiveTo          DateTime?
  capabilities         Json
  assignedByUserId     String
  endedByUserId        String?
  reason               String
  endReason            String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  endedAt              DateTime?
  organization         HrOrganization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supervisorEmployee   HrEmployee                 @relation("SupervisorEmployee", fields: [supervisorEmployeeId], references: [id], onDelete: Restrict)
  assignedEmployee     HrEmployee?                @relation("AssignedEmployee", fields: [assignedEmployeeId], references: [id], onDelete: Restrict)
  departmentScope      HrDepartment?              @relation(fields: [departmentScopeId], references: [id], onDelete: Restrict)
  teamScope            HrTeam?                    @relation(fields: [teamScopeId], references: [id], onDelete: Restrict)
  assignedBy           HrUser                     @relation("SupervisorAssignmentGrantor", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  endedBy              HrUser?                    @relation("SupervisorAssignmentEnder", fields: [endedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, supervisorEmployeeId, status, effectiveFrom, effectiveTo])
  @@index([organizationId, assignedEmployeeId, status])
  @@index([organizationId, departmentScopeId, teamScopeId, status])
}

model HrAuditEvent {
  id             String         @id @default(cuid())
  organizationId String
  actorUserId    String?
  actorRole      String?
  entityType     String
  entityId       String?
  action         String
  previousValues Json?
  newValues      Json?
  reason         String?
  ipHash         String?
  userAgent      String?
  requestId      String?
  correlationId  String
  createdAt      DateTime       @default(now())
  organization   HrOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          HrUser?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId, createdAt])
  @@index([organizationId, actorUserId, createdAt])
  @@index([correlationId])
}

model HrEmailOutbox {
  id                String                   @id @default(cuid())
  organizationId    String
  recipient         String
  template          String
  subject           String
  payload           Json
  status            HrOutboxStatus           @default(PENDING)
  attemptCount      Int                      @default(0)
  nextAttemptAt     DateTime                 @default(now())
  lastAttemptedAt   DateTime?
  lastError         String?
  provider          String?
  providerMessageId String?
  idempotencyKey    String                   @unique
  createdAt         DateTime                 @default(now())
  deliveredAt       DateTime?
  organization      HrOrganization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  attempts          HrEmailDeliveryAttempt[]

  @@index([status, nextAttemptAt])
  @@index([status, createdAt])
  @@index([organizationId, createdAt])
}

model HrEmailDeliveryAttempt {
  id                String         @id @default(cuid())
  outboxId          String
  attemptNumber     Int
  status            HrOutboxStatus
  provider          String?
  providerMessageId String?
  safeError         String?
  attemptedAt       DateTime       @default(now())
  outbox            HrEmailOutbox  @relation(fields: [outboxId], references: [id], onDelete: Cascade)

  @@unique([outboxId, attemptNumber])
}

model HrLeaveType {
  id                 String           @id @default(cuid())
  organizationId     String
  code               String
  name               String
  description        String?
  unit               HrLeaveUnit      @default(DAYS)
  paid               Boolean          @default(true)
  requiresAttachment Boolean          @default(false)
  status             HrRecordStatus   @default(ACTIVE)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  archivedAt         DateTime?
  organization       HrOrganization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  policies           HrLeavePolicy[]
  balances           HrLeaveBalance[]
  requests           HrLeaveRequest[]

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model HrLeavePolicy {
  id                   String                  @id @default(cuid())
  organizationId       String
  leaveTypeId          String
  name                 String
  version              Int
  entitlement          Decimal                 @db.Decimal(10, 2)
  accrualFrequency     HrLeaveAccrualFrequency @default(ANNUALLY)
  accrualAmount        Decimal?                @db.Decimal(10, 2)
  maximumBalance       Decimal?                @db.Decimal(10, 2)
  carryOverLimit       Decimal?                @db.Decimal(10, 2)
  carryOverExpiryMonth Int?
  minimumNoticeDays    Int                     @default(0)
  maximumConsecutive   Decimal?                @db.Decimal(10, 2)
  probationMonths      Int                     @default(0)
  allowNegativeBalance Boolean                 @default(false)
  requiresApproval     Boolean                 @default(true)
  effectiveFrom        DateTime
  effectiveTo          DateTime?
  status               HrRecordStatus          @default(ACTIVE)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  organization         HrOrganization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  leaveType            HrLeaveType             @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  employeeAssignments  HrEmployeeLeavePolicy[]
  balances             HrLeaveBalance[]
  requests             HrLeaveRequest[]

  @@unique([organizationId, leaveTypeId, version])
  @@index([organizationId, status, effectiveFrom, effectiveTo])
}

model HrEmployeeLeavePolicy {
  id            String             @id @default(cuid())
  employeeId    String
  leavePolicyId String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        HrAssignmentStatus @default(ACTIVE)
  reason        String
  assignedById  String
  endedById     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  employee      HrEmployee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leavePolicy   HrLeavePolicy      @relation(fields: [leavePolicyId], references: [id], onDelete: Restrict)
  assignedBy    HrUser             @relation("LeavePolicyAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  endedBy       HrUser?            @relation("LeavePolicyEnder", fields: [endedById], references: [id], onDelete: Restrict)

  @@index([employeeId, status, effectiveFrom, effectiveTo])
  @@index([leavePolicyId, status])
}

model HrLeaveBalance {
  id             String           @id @default(cuid())
  organizationId String
  employeeId     String
  leaveTypeId    String
  leavePolicyId  String
  periodYear     Int
  opening        Decimal          @default(0) @db.Decimal(10, 2)
  accrued        Decimal          @default(0) @db.Decimal(10, 2)
  carriedOver    Decimal          @default(0) @db.Decimal(10, 2)
  adjusted       Decimal          @default(0) @db.Decimal(10, 2)
  reserved       Decimal          @default(0) @db.Decimal(10, 2)
  used           Decimal          @default(0) @db.Decimal(10, 2)
