# Staging-only. Do not point these at production until staging is reviewed.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
NEXT_PUBLIC_SITE_URL=https://staging.zentricanalytics.com
ADMIN_SESSION_SECRET=replace-with-long-random-secret
EMAIL_PROVIDER=console # use resend on staging after RESEND_API_KEY is set
PRIVATE_UPLOAD_ROOT=/var/data/zentric-private-uploads

EMAIL_FROM=careers@zentricanalytics.com
APP_BASE_URL=https://staging.zentricanalytics.com
RESEND_API_KEY=replace-with-render-secret
UPLOAD_MAX_BYTES=20971520

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=pbkdf2_sha256$310000$replace-with-salt$replacewithhexhash
# Optional staging-only flag reserved for secret-free admin auth diagnostics.
ADMIN_AUTH_DIAGNOSTICS=false
# Applicant tracking rate limits. Keep enabled; staging may tune these for QA without disabling protection.
ACCESS_CODE_REQUEST_LIMIT=5
ACCESS_CODE_VERIFY_LIMIT=5
RATE_LIMIT_WINDOW_MS=900000
