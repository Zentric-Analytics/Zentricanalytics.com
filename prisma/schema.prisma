}

model HrRecruitmentOfferVersion {
  id               String              @id @default(cuid())
  offerId          String
  version          Int
  positionId       String?
  positionTitle    String
  departmentId     String
  managerId        String?
  legalEntityId    String
  employmentType   String
  gradeId          String?
  salary           Decimal             @db.Decimal(18, 2)
  currency         String
  payFrequency     String
  allowances       Json
  benefits         Json
  location         String?
  workMode         String
  startDate        DateTime
  probationPeriod  String?
  contractType     String
  expiresAt        DateTime
  terms            Json
  createdById      String
  createdAt        DateTime            @default(now())
  offer            HrRecruitmentOffer  @relation("OfferVersions", fields: [offerId], references: [id], onDelete: Cascade)
  activeForOffer   HrRecruitmentOffer? @relation("ActiveOfferVersion")
  acceptedForOffer HrRecruitmentOffer? @relation("AcceptedOfferVersion")

  @@unique([offerId, version])
  @@index([offerId, createdAt])
}

model HrRecruitmentOfferApproval {
  id             String             @id @default(cuid())
  offerId        String
  offerVersionId String
  step           Int
  decision       String
  approverId     String
  comments       String?
  decidedAt      DateTime           @default(now())
  offer          HrRecruitmentOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([offerVersionId, step])
  @@index([approverId, decidedAt])
}

model HrRecruitmentOfferDelivery {
  id             String             @id @default(cuid())
  offerId        String
  offerVersionId String
  channel        String
  status         String             @default("QUEUED")
  idempotencyKey String             @unique
  deliveredAt    DateTime?
  createdAt      DateTime           @default(now())
  offer          HrRecruitmentOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
}

model HrRecruitmentOfferAcceptance {
  id             String                 @id @default(cuid())
  offerId        String                 @unique
  offerVersionId String                 @unique
  applicantId    String
  method         String
  evidence       Json?
  acceptedAt     DateTime               @default(now())
  offer          HrRecruitmentOffer     @relation(fields: [offerId], references: [id], onDelete: Restrict)
  handover       HrRecruitmentHandover?
}

model HrRecruitmentOfferDecline {
  id             String             @id @default(cuid())
  offerId        String             @unique
  offerVersionId String
  applicantId    String
  reason         String?
  declinedAt     DateTime           @default(now())
  offer          HrRecruitmentOffer @relation(fields: [offerId], references: [id], onDelete: Restrict)
}

model HrRecruitmentHandover {
  id                 String                        @id @default(cuid())
  organizationId     String
  applicationId      String
  offerAcceptanceId  String                        @unique
  assignedHrTeamId   String
  ownerUserId        String?
  status             String                        @default("PENDING_HR_REVIEW")
  version            Int                           @default(1)
  approvedAt         DateTime?
  approvedById       String?
  cancellationReason String?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  offerAcceptance    HrRecruitmentOfferAcceptance  @relation(fields: [offerAcceptanceId], references: [id], onDelete: Restrict)
  requirements       HrRecruitmentRequirement[]
  documentReviews    HrRecruitmentDocumentReview[]
  conversion         HrPreHireConversion?

  @@index([organizationId, status, updatedAt])
  @@index([assignedHrTeamId, status])
}

model HrRecruitmentRequirementDefinition {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  name           String
  description    String?
  blocking       Boolean  @default(true)
  evidenceType   String?
  active         Boolean  @default(true)
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key])
}

model HrRecruitmentRequirement {
  id             String                @id @default(cuid())
  handoverId     String
  definitionId   String
  status         String                @default("NOT_STARTED")
  blocking       Boolean
  evidence       Json?
  evaluatedAt    DateTime?
  evaluatedById  String?
  overrideReason String?
  expiresAt      DateTime?
  version        Int                   @default(1)
  handover       HrRecruitmentHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade)

  @@unique([handoverId, definitionId])
  @@index([handoverId, status, blocking])
}

model HrRecruitmentDocumentReview {
  id                 String                @id @default(cuid())
  handoverId         String
  uploadedDocumentId String
  documentVersion    Int                   @default(1)
  reviewScope        String
  status             String                @default("PENDING")
  reviewedById       String?
  reason             String?
  reviewedAt         DateTime?
  replacedById       String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  handover           HrRecruitmentHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade)

  @@unique([handoverId, uploadedDocumentId, documentVersion, reviewScope])
  @@index([handoverId, status])
}

model HrCandidateEmployeeLink {
  id             String   @id @default(cuid())
  organizationId String
  applicantId    String   @unique
  employeeId     String   @unique
  applicationId  String
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

model HrPreHireConversion {
  id                  String                @id @default(cuid())
  organizationId      String
  handoverId          String                @unique
  applicantId         String                @unique
  applicationId       String                @unique
  employeeId          String                @unique
  lifecycleInstanceId String                @unique
  idempotencyKey      String                @unique
  convertedById       String
  convertedAt         DateTime              @default(now())
  handover            HrRecruitmentHandover @relation(fields: [handoverId], references: [id], onDelete: Restrict)

  @@index([organizationId, convertedAt])
}

model HrRecruitmentActivation {
  id                  String    @id @default(cuid())
  organizationId      String
  employeeId          String    @unique
  employeeActivatedAt DateTime?
  userActivatedAt     DateTime?
  activatedById       String?
  source              String
  idempotencyKey      String    @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([organizationId, createdAt])
}
