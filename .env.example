DATABASE_URL="postgresql://user:password@localhost:5432/zentric"
EMAIL_PROVIDER="console"
EMAIL_FROM="careers@zentricanalytics.com"
APP_BASE_URL="https://zentricanalytics.com"
UPLOAD_MAX_BYTES="20971520"
UPLOAD_STORAGE_PRIVATE_BUCKET="zentric-hiring-private"
ADMIN_SESSION_SECRET="replace-with-secure-secret"

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=pbkdf2_sha256$310000$replace-with-salt$replacewithhexhash
# Applicant tracking rate limits. Defaults: 5 requests/verifications per 15 minutes per application/email/IP key.
ACCESS_CODE_REQUEST_LIMIT=5
ACCESS_CODE_VERIFY_LIMIT=5
RATE_LIMIT_WINDOW_MS=900000

# HRMS secure foundation
APPLICATION_BASE_URL="http://localhost:3000"
AUTH_SECRET="replace-with-at-least-32-random-characters"
AUTH_SESSION_TTL=28800
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD_HASH="$2b$12$replace-with-a-real-bcrypt-hash"
OBJECT_STORAGE_PROVIDER="local"
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_REGION=""
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
OBJECT_STORAGE_FORCE_PATH_STYLE=true
HR_LOCAL_STORAGE_ROOT=".hr-private"
EMAIL_WORKER_SECRET="replace-with-random-worker-secret"
SCHEDULED_JOB_SECRET="replace-with-random-scheduler-secret"
APP_ENV="development"
