DATABASE_URL="postgresql://user:password@localhost:5432/zentric"
EMAIL_PROVIDER="console"
EMAIL_FROM="careers@zentricanalytics.com"
APP_BASE_URL="https://zentricanalytics.com"
UPLOAD_MAX_BYTES="20971520"
UPLOAD_STORAGE_PRIVATE_BUCKET="zentric-hiring-private"
ADMIN_SESSION_SECRET="replace-with-secure-secret"

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=pbkdf2_sha256$310000$replace-with-salt$replacewithhexhash
# Applicant tracking rate limits. Defaults: 5 requests/verifications per 15 minutes per application/email/IP key.
ACCESS_CODE_REQUEST_LIMIT=5
ACCESS_CODE_VERIFY_LIMIT=5
RATE_LIMIT_WINDOW_MS=900000

# Optional canonical base URL used in email links.
NEXT_PUBLIC_SITE_URL="https://zentricanalytics.com"
# Set to "resend" only when RESEND_API_KEY is configured; otherwise use "console" for local development.
RESEND_API_KEY=""
# Private uploads must remain outside public/. Use durable private storage in production.
PRIVATE_OBJECT_STORAGE_PROVIDER="local-private"
PRIVATE_UPLOAD_ROOT=".private-uploads"
# Optional salt for rate-limit keys; use a secret value in production.
RATE_LIMIT_SALT=""
APP_ENV="development"
